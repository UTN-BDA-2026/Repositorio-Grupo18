# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO PARA LA APLICACIÓN SMARTFARMING

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=nombre-postgres-db

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=usuario
MONGO_PASSWORD=password
MONGO_DB=nombre-mongo-db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── pgvector ──────────────────────────────────────────────────────────────────
BEHAVIOR_VECTOR_DIM=128
ALERT_SIMILARITY_THRESHOLD=0.85
